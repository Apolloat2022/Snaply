# Stripe (client-side publishable key is safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Prefer a restricted key (rk_...) scoped to Checkout Sessions + webhook read access
STRIPE_SECRET_KEY=
# From `stripe listen --print-secret` in dev, or the webhook endpoint's signing secret in the Dashboard
STRIPE_WEBHOOK_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=listing-images

# FastAPI engine
FASTAPI_BASE_URL=http://localhost:8000

# Seller sale-notification email (src/lib/email.ts). Leave unset in dev —
# emails are logged instead of sent when RESEND_API_KEY is empty.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=orders@snaply-app.example
