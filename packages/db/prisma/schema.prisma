generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  DRAFT // AI profile generated, seller hasn't published
  ACTIVE
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum NotificationType {
  ORDER_PAID
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  regionCode  String? // default state/postal code used to seed sales-tax calc on their own listings
  createdAt   DateTime @default(now())

  listings      Listing[]      @relation("SellerListings")
  orders        Order[]        @relation("BuyerOrders")
  notifications Notification[]

  @@map("users")
}

/// A listing profile as auto-generated by the FastAPI /api/analyze-item pipeline,
/// then reviewed/published by the seller. Field names mirror AnalyzeItemResponse
/// (apps/api/app/models/schemas.py) so the API payload maps onto this model 1:1.
model Listing {
  id     String @id @default(cuid())
  seller User   @relation("SellerListings", fields: [sellerId], references: [id])
  sellerId String

  imageUrl String

  title          String
  description    String @db.Text
  category       String
  manufacturer   String?
  condition      ItemCondition
  conditionNotes String?       @db.Text

  listingPrice              Decimal @db.Decimal(10, 2)
  estimatedShippingWeightLb Decimal @db.Decimal(6, 2)
  regionCode                String // seller's region, used for sales-tax calc at checkout

  aiConfidence Decimal? @db.Decimal(3, 2)
  comparables  Json? // snapshot of ComparableListing[] used to derive listingPrice

  status ListingStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@map("listings")
}

/// One purchase against a Listing. Amounts are stored in cents to match what's
/// sent to the Stripe Checkout Sessions API (see StripeCheckout.tsx / checkout/create-session/route.ts).
/// No Return Policy acceptance is persisted here as the durable record, in addition
/// to being stamped into the Checkout Session's own metadata at creation time.
model Order {
  id      String  @id @default(cuid())
  listing Listing @relation(fields: [listingId], references: [id])
  listingId String

  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId String

  itemCostCents  Int
  salesTaxCents  Int
  postalFeeCents Int
  totalCents     Int

  status OrderStatus @default(PENDING)

  stripeCheckoutSessionId String  @unique
  stripePaymentIntentId   String? @unique

  noReturnPolicyAccepted   Boolean   @default(false)
  noReturnPolicyAcceptedAt DateTime?
  noReturnPolicyText       String    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
  @@map("orders")
}

/// In-app record of a seller-facing event (currently just "your listing sold").
/// Written in the same DB transaction as the Order/Listing update so it can
/// never drift out of sync with what actually happened; the outbound email is
/// sent as a separate best-effort step afterward (see lib/notifications.ts).
model Notification {
  id     String           @id @default(cuid())
  user   User             @relation(fields: [userId], references: [id])
  userId String

  type NotificationType

  title String
  body  String @db.Text

  listingId String?
  orderId   String?

  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}
