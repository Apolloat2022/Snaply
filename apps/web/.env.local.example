# Square Web Payments SDK (client-side, safe to expose)
NEXT_PUBLIC_SQUARE_ENV=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Square Payments API (server-only route: src/app/api/square/create-payment/route.ts)
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=listing-images

# FastAPI engine
FASTAPI_BASE_URL=http://localhost:8000

# Seller sale-notification email (src/lib/email.ts). Leave unset in dev —
# emails are logged instead of sent when RESEND_API_KEY is empty.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=orders@snaply-app.example
